# Purpl — environment variables
# Copy this file to `.env.local` (gitignored) and fill in the real values.

# VolleyTube Supabase — backs the /volleytube/waitlist signup form.
# Namespaced VOLLEYTUBE_ so other Purpl backends can be added later without
# clashing. From the VolleyTube Supabase project → Project Settings → API.
# Use the PUBLISHABLE key (sb_publishable_...), NOT the secret key.
VOLLEYTUBE_SUPABASE_URL=https://your-project-ref.supabase.co
VOLLEYTUBE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
