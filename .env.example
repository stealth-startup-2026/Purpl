# Purpl — environment variables
# Copy this file to `.env.local` (gitignored) and fill in the real values.

# Supabase (waitlist storage). From Purpl's Supabase project:
#   Project Settings → API
# Use the PUBLISHABLE key (sb_publishable_...), NOT the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
